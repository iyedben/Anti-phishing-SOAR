# ==============================================================================
# Anti-Phishing SOAR — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# --- TheHive 4 Configuration ---
# Secret key used by Play framework for cookie signing and session security
# Must be kept private and excluded from Git
THEHIVE_PLAY_SECRET=AntiPhishingSOARSecretKey2026LabEnvChangeMeInProd

# JVM Heap settings for TheHive 4
THEHIVE_JAVA_OPTS=-Xms384m -Xmx384m

# --- Cassandra 4.0 Configuration ---
CASSANDRA_CLUSTER_NAME=th-cluster
CASSANDRA_MAX_HEAP_SIZE=384M
CASSANDRA_HEAP_NEWSIZE=96M

# --- Elasticsearch 7.17 Configuration ---
ES_JAVA_OPTS=-Xms384m -Xmx512m

# --- Cortex 3.1.8 Configuration ---
# Secret key used by Play framework for Cortex session security
CORTEX_SECRET=ChangeThisToASecureRandomStringForProductionUse
CORTEX_JAVA_OPTS=-Xms384m -Xmx384m

# Cortex superAdmin credentials template (used for initial onboarding)
CORTEX_ADMIN_USER=admin
CORTEX_ADMIN_PASSWORD=ChangeMeLabPassword123!
